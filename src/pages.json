			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"tabBar": {
		"color": "#6b7280",
		"selectedColor": "#2563eb",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页"
			},
			{
				"pagePath": "pages/cart/cart",
				"text": "购物车"
			}
		]
	}
